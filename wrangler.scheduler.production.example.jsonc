{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-mail-sender-scheduler",
  "main": "src/send-scheduler.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DASHBOARD_API_URL": "https://REPLACE-WITH-YOUR-PAGES-URL.pages.dev"
  }
}
